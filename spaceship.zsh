# prompt order (left & right sides)
SPACESHIP_PROMPT_ORDER=(jobs venv user host dir git
                        line_sep
                        exit_code char)
SPACESHIP_RPROMPT_ORDER=(exec_time)

# jobs section
SPACESHIP_JOBS_SHOW=true
SPACESHIP_JOBS_PREFIX=" "
SPACESHIP_JOBS_SUFFIX=" "
SPACESHIP_JOBS_SYMBOL="\u2699"
SPACESHIP_JOBS_COLOR="#7EBAB2"

# venv section
SPACESHIP_VENV_SHOW=true
SPACESHIP_VENV_PREFIX=" "
SPACESHIP_VENV_COLOR="#E57D7F"

# user section
SPACESHIP_USER_SHOW=always
SPACESHIP_USER_COLOR=white
SPACESHIP_USER_PREFIX=" "
SPACESHIP_USER_SUFFIX="@"

# host section
SPACESHIP_HOST_SHOW=always
SPACESHIP_HOST_PREFIX=""
SPACESHIP_HOST_COLOR=white

# dir section
SPACESHIP_DIR_TRUNC_REPO=false
SPACESHIP_DIR_TRUNC=2
SPACESHIP_DIR_PREFIX=""
SPACESHIP_DIR_COLOR=blue

# git section
SPACESHIP_GIT_BRANCH_COLOR=yellow
SPACESHIP_GIT_STATUS_COLOR=yellow
SPACESHIP_GIT_COMMIT_PREFIX=" \e[33;1m("
SPACESHIP_GIT_COMMIT_SUFFIX="\e[33;1m)"
SPACESHIP_GIT_COMMIT_SYMBOL=""
SPACESHIP_GIT_COMMIT_SHOW=always

# exit code section
SPACESHIP_EXIT_CODE_SHOW=true
SPACESHIP_EXIT_CODE_SYMBOL=""

# exec_time section
SPACESHIP_EXEC_TIME_SHOW=true
SPACESHIP_EXEC_TIME_PREFIX=""
SPACESHIP_EXEC_TIME_SUFFIX=""
SPACESHIP_EXEC_TIME_COLOR=white
SPACESHIP_EXEC_TIME_ELAPSED=0
SPACESHIP_EXEC_TIME_PRECISION=3

